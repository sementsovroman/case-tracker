generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Case {
  id          String   @id @default(cuid())
  title       String
  description String
  court       String
  judge       String
  plaintiff   String
  defendant   String
  color       String   @default("#3b82f6")
  notes       String
  archived    Boolean  @default(false)

  hearings    Hearing[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Hearing {
  id        String      @id @default(cuid())
  caseId    String
  kind      String      @default("hearing")
  start     DateTime
  end       DateTime

  case      Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([start, end])
  @@index([caseId])
}
