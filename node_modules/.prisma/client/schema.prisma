generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  start       DateTime
  end         DateTime
  color       String   @default("#3b82f6")

  // future fields
  timezone String?
  location String?
  isPublic Boolean?
  meta     String? // JSON string for SQLite; switch to Json with Postgres

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([start, end])
}
